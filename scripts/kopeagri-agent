#!/usr/bin/env bash
set -euo pipefail
ROOT="/opt/vlad/projects/KOPEAGRI"
TASK="${*:-}"
[ -n "$TASK" ] || { echo 'usage: kopeagri-agent "instruction"'; exit 1; }

CONTEXT=$(cat "$ROOT/docs/AGENT_CONTEXT.md")
POLICY=$(cat "$ROOT/docs/AUTOMATION_POLICY.md")
PROMPT="$CONTEXT

$POLICY

TÂCHE DEMANDÉE:
$TASK

Réponds en 220 mots maximum avec: faits vérifiés et preuves, actions proposées, risques, prochaines étapes et validations humaines requises."

python3 - "$PROMPT" <<'PY'
import json,sys,urllib.request
prompt=sys.argv[1]
payload=json.dumps({
    "model":"supergtp",
    "prompt":prompt,
    "stream":False,
    "keep_alive":"10m",
    "options":{"num_predict":220,"temperature":0.2}
}).encode()
req=urllib.request.Request(
    "http://127.0.0.1:11434/api/generate",
    data=payload,
    headers={"Content-Type":"application/json"},
)
with urllib.request.urlopen(req,timeout=90) as r:
    data=json.load(r)
print(data.get("response","").strip())
PY
